rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Each coach can only read and write their own playbook.
    match /users/{uid}/plays/{playId} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.id == playId
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 120
        && request.resource.data.players is list
        && request.resource.data.players.size() <= 11
        && request.resource.data.assignments is map;
    }
    // Coach AI usage counters are written only by Cloud Functions.
    match /users/{uid}/meta/{doc} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }
  }
}
